Finally, compare recent daily coverage:

```sql
WITH original_daily AS (
    SELECT
        CAST(last_update_timestamp AS DATE) AS record_date,
        COUNT(DISTINCT contact_id) AS original_contacts
    FROM public.ctr
    WHERE last_update_timestamp >= DATEADD(day, -14, GETDATE())
    GROUP BY CAST(last_update_timestamp AS DATE)
),
flattened_daily AS (
    SELECT
        CAST(last_update_timestamp AS DATE) AS record_date,
        COUNT(DISTINCT contact_id) AS flattened_contacts
    FROM public.ctr_flattened
    WHERE last_update_timestamp >= DATEADD(day, -14, GETDATE())
    GROUP BY CAST(last_update_timestamp AS DATE)
)
SELECT
    COALESCE(o.record_date, f.record_date) AS record_date,
    COALESCE(o.original_contacts, 0) AS original_contacts,
    COALESCE(f.flattened_contacts, 0) AS flattened_contacts,
    COALESCE(o.original_contacts, 0)
        - COALESCE(f.flattened_contacts, 0) AS difference
FROM original_daily o
FULL OUTER JOIN flattened_daily f
    ON o.record_date = f.record_date
ORDER BY record_date DESC;
```

