SELECT
    'CTR FLATTENED' AS table_name,
    MAX(last_update_timestamp) AS latest_timestamp
FROM public.ctr_flattened;




Run this first. It checks for missing contacts, duplicates and timestamp mismatches against the latest version in `public.ctr`:

```sql
WITH ctr_latest AS (
    SELECT
        contact_id,
        MAX(last_update_timestamp) AS expected_timestamp
    FROM public.ctr
    WHERE contact_id IS NOT NULL
    GROUP BY contact_id
),
flattened AS (
    SELECT
        contact_id,
        COUNT(*) AS row_count,
        MAX(last_update_timestamp) AS actual_timestamp
    FROM public.ctr_flattened
    WHERE contact_id IS NOT NULL
    GROUP BY contact_id
),
validation AS (
    SELECT
        c.contact_id,
        CASE
            WHEN f.contact_id IS NULL
                THEN 'MISSING_FROM_FLATTENED'
            WHEN f.row_count > 1
                THEN 'DUPLICATE'
            WHEN f.actual_timestamp <> c.expected_timestamp
                THEN 'TIMESTAMP_MISMATCH'
            ELSE 'LATEST_MATCHES'
        END AS validation_status
    FROM ctr_latest c
    LEFT JOIN flattened f
        ON c.contact_id = f.contact_id
)
SELECT
    validation_status,
    COUNT(*) AS contact_count
FROM validation
GROUP BY validation_status
ORDER BY validation_status;
```

What you want:

* `MISSING_FROM_FLATTENED`: absent or `0`
* `DUPLICATE`: absent or `0`
* `TIMESTAMP_MISMATCH`: ideally `0`
* `LATEST_MATCHES`: all expected contacts

Then verify the latest available record and when the initial load wrote it:

```sql
SELECT
    COUNT(*) AS total_rows,
    COUNT(DISTINCT contact_id) AS distinct_contacts,
    MIN(last_update_timestamp) AS earliest_ctr,
    MAX(last_update_timestamp) AS latest_ctr,
    MAX(etl_loaded_timestamp) AS latest_etl_load
FROM public.ctr_flattened;
```

Finally, compare recent daily coverage:

```sql
WITH original_daily AS (
    SELECT
        CAST(last_update_timestamp AS DATE) AS record_date,
        COUNT(DISTINCT contact_id) AS original_contacts
    FROM public.ctr
    WHERE last_update_timestamp >= DATEADD(day, -14, GETDATE())
    GROUP BY CAST(last_update_timestamp AS DATE)
),
flattened_daily AS (
    SELECT
        CAST(last_update_timestamp AS DATE) AS record_date,
        COUNT(DISTINCT contact_id) AS flattened_contacts
    FROM public.ctr_flattened
    WHERE last_update_timestamp >= DATEADD(day, -14, GETDATE())
    GROUP BY CAST(last_update_timestamp AS DATE)
)
SELECT
    COALESCE(o.record_date, f.record_date) AS record_date,
    COALESCE(o.original_contacts, 0) AS original_contacts,
    COALESCE(f.flattened_contacts, 0) AS flattened_contacts,
    COALESCE(o.original_contacts, 0)
        - COALESCE(f.flattened_contacts, 0) AS difference
FROM original_daily o
FULL OUTER JOIN flattened_daily f
    ON o.record_date = f.record_date
ORDER BY record_date DESC;
```

The first query is the decisive skipped-data check. Don’t send the update until we see its output.
