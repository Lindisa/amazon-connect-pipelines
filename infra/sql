Use this to compare the original UTC timestamp with the expected and actual SAST value:

```sql
WITH ctr_latest AS (
    SELECT
        contact_id,
        initiation_timestamp,
        last_update_timestamp,
        ROW_NUMBER() OVER (
            PARTITION BY contact_id
            ORDER BY last_update_timestamp DESC
        ) AS rn
    FROM public.ctr
    WHERE initiation_timestamp >= DATEADD(day, -1, GETDATE())
)
SELECT
    c.contact_id,
    c.initiation_timestamp                    AS source_utc,
    DATEADD(hour, 2, c.initiation_timestamp) AS expected_sast,
    f.initiation_timestamp                    AS flattened_timestamp,
    CASE
        WHEN f.initiation_timestamp =
             DATEADD(hour, 2, c.initiation_timestamp)
        THEN 'MATCH'
        ELSE 'MISMATCH'
    END AS validation_status
FROM ctr_latest c
JOIN public.ctr_flattened f
    ON c.contact_id = f.contact_id
WHERE c.rn = 1
ORDER BY c.initiation_timestamp DESC
LIMIT 100;
```

For an overall result:

```sql
WITH ctr_latest AS (
    SELECT
        contact_id,
        initiation_timestamp,
        last_update_timestamp,
        ROW_NUMBER() OVER (
            PARTITION BY contact_id
            ORDER BY last_update_timestamp DESC
        ) AS rn
    FROM public.ctr
    WHERE initiation_timestamp >= DATEADD(day, -1, GETDATE())
)
SELECT
    CASE
        WHEN f.initiation_timestamp =
             DATEADD(hour, 2, c.initiation_timestamp)
        THEN 'MATCH'
        ELSE 'MISMATCH'
    END AS validation_status,
    COUNT(*) AS record_count
FROM ctr_latest c
JOIN public.ctr_flattened f
    ON c.contact_id = f.contact_id
WHERE c.rn = 1
GROUP BY 1;
```

The successful result should show the flattened timestamp exactly **two hours ahead** of the source UTC timestamp.








DROP PROCEDURE IF EXISTS check_empty_strings();

CREATE OR REPLACE PROCEDURE check_empty_strings()
AS $$
DECLARE
    col RECORD;
    sql_text VARCHAR(65535);
BEGIN
    DROP TABLE IF EXISTS empty_string_results;

    CREATE TEMP TABLE empty_string_results (
        column_name       VARCHAR(256),
        empty_value_count BIGINT
    );

    FOR col IN
        SELECT column_name
        FROM information_schema.columns
        WHERE table_schema = 'public'
          AND table_name = 'ctr_flattened'
          AND data_type IN (
              'character varying',
              'character',
              'varchar',
              'char',
              'text'
          )
        ORDER BY ordinal_position
    LOOP
        sql_text :=
            'INSERT INTO empty_string_results ' ||
            'SELECT ''' || col.column_name || ''', COUNT(*) ' ||
            'FROM public.ctr_flattened ' ||
            'WHERE ' || col.column_name || ' IS NOT NULL ' ||
            'AND TRIM(' || col.column_name || ') = '''';';

        EXECUTE sql_text;
    END LOOP;
END;
$$ LANGUAGE plpgsql;

CALL check_empty_strings();

SELECT
    column_name,
    empty_value_count
FROM empty_string_results
WHERE empty_value_count > 0
ORDER BY empty_value_count DESC, column_name;


