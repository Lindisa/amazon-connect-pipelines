# =========================================================
# GLOBAL
# =========================================================

aws_region  = "af-south-1"
environment = "sit"

project_id      = "contact-lens-pipeline"
project_name    = "contact-lens-pipeline"
resource_prefix = "npsenvoicesit"


# =========================================================
# S3
# =========================================================

source_bucket_name = "afs1-npsenvoicesit-voice-connect-storage-sit"

# Contact Lens source JSON location
source_prefix = "Analysis/Voice/"

target_bucket_name = "afs1-npsenvoicesit-voice-connect-storage-sit"

# Partitioned Parquet output location
target_prefix = "Analysis/Voice/contact-lens/pre-processed/"

glue_scripts_bucket_name = "afs1-sit-conivr-voice-connect-storage-etl-script-store"


# =========================================================
# NEW GLUE CONNECTIONS
# =========================================================

network_glue_connection_name = "NPS_Network_Connection_sit_92"

redshift_glue_connection_name = "Amazon_Redshift_Connection_sit_92"


# =========================================================
# GLUE CONNECTION NETWORK CONFIGURATION
# =========================================================

glue_connection_availability_zone = "af-south-1a"

glue_connection_subnet_id = "subnet-0980c565baf160215"

glue_connection_security_group_ids = [
  "sg-0cc43dc09a5e0b10a"
]


# =========================================================
# REDSHIFT JDBC CONNECTION
#
# Use the endpoint from the existing
# Amazon_Redshift_Connection_sit connection.
# The database is amazonconnectdatawarehouse.
# =========================================================

redshift_jdbc_url = "jdbc:redshift://<SIT_REDSHIFT_ENDPOINT>:5439/amazonconnectdatawarehouse"

# These values should be supplied through protected
# GitHub environment secrets as TF_VAR variables.
#
# TF_VAR_redshift_username
# TF_VAR_redshift_password


# =========================================================
# GLUE DATA CATALOG
# =========================================================

glue_catalog_database = "connect_db_sit"

glue_catalog_table = "contactlens_pre_processed"


# =========================================================
# REDSHIFT
# =========================================================

redshift_target_table = "public.contact_lens"

